UID:2026-09-02-schedprep@plan.py
DTSTART;VALUE=DATE:20260902
DTEND;VALUE=DATE:20260903
SUMMARY:🛒 Start pork shoulder in the slow cooker Wednesday morning
DESCRIPTION:Carnitas Tacos is in 0 days
END:VEVENT
